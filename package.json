{
  "name": "humanOS-frontend",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck && tsc -p tests",
    "test:e2e": "playwright test",
    "screenshots": "playwright test tests/e2e/screens.spec.ts tests/e2e/auth.spec.ts tests/e2e/features",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "gen:api": "openapi-typescript ../humanOS-backend/docs/openapi/v1.json -o app/types/api.generated.ts"
  },
  "dependencies": {
    "nuxt": "^4.6.0",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/test-utils": "^4.3.3",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.12.0",
    "happy-dom": "^20.14.6",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.3.12"
  }
}
